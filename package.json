{
  "name": "regen-commons-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Regen Commons public site — static frontend + Vercel serverless functions backed by Notion and Resend.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:live": "vercel dev --listen 3502",
    "check": "node scripts/check.js",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "deploy": "vercel deploy --prod"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "resend": "^4.0.0"
  },
  "engines": {
    "node": "22.x"
  }
}
