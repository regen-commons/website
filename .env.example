# Server-only live configuration. Default npm run dev strips these settings.
# Regen Commons / Website; never substitute an unrelated Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Random server intake capability; only its SHA-256 digest belongs in private.intake_settings.
# Provision through an authorized operator. Never expose this in browser assets.
SUPABASE_INTAKE_SECRET=
# Exact HTTPS website origin, without path or trailing slash.
ADMIN_ORIGIN=

# Optional application receipts/steward alerts; separate from Supabase Auth SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Existing monitored inbox for replies; defaults to the public website contact.
RESEND_REPLY_TO_EMAIL=
STEWARD_NOTIFY_EMAILS=
# Optional Telegram-agent notifications.
NOTIFY_URL=
NOTIFY_WEBHOOK_SECRET=
# No Notion credential or service-role key is needed by the new runtime.
