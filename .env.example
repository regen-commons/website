# Only needed for explicitly configured live integration work.
# Default npm run dev uses fixtures and does not load this file.
# Notion ─────────────────────────────────────────────
# Internal integration token from https://www.notion.so/profile/integrations
NOTION_TOKEN=

# 32-char hex IDs from each database URL (the bit before "?v=")
NOTION_MEMBERS_DB_ID=
NOTION_CONTRIBUTIONS_DB_ID=
NOTION_SEEDS_DB_ID=

# Resend ─────────────────────────────────────────────
# API key from https://resend.com/api-keys (starts re_…)
RESEND_API_KEY=

# Verified sender on your domain (e.g. hello@yourdomain.org)
RESEND_FROM_EMAIL=

# Comma-separated list of stewards to notify on each new application
STEWARD_NOTIFY_EMAILS=

# Optional Telegram-agent notification webhook (server-side only)
NOTIFY_URL=
NOTIFY_WEBHOOK_SECRET=

# SITE_URL was present in the original handoff but is not read by current code.
